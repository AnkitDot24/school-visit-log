{
  "name": "school-visit-log-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + Mongoose API for the School Visit Log",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
